# Gemini
gemini_api_key=

# LLM model for every generation task (PLAN 5.1)
gemini_model=gemini-3.7-flash

# Claude interviewer credentials and provider selection; other LLM tasks stay on Gemini.
claude_api_key=
interview_provider=gemini
claude_model=claude-haiku-4-5-20251001

# File Search store name, injected after Phase 1 upload script runs (PLAN 5.6)
file_search_store_name=

# GCP project for Firestore, wired in Phase 4 (PLAN 9.1)
gcp_project_id=

# Interview pacing and axis coverage, tunable during the pilot (PLAN 3.2)
interview_target_turns=18
# Begin suggesting uncovered interview topics at this turn.
interview_hint_turn=10
interview_wrapup_turn=15

# Developer fixture routes must stay disabled in production.
# dev_mode=false
